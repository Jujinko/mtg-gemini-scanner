rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /judgeRulings/{rulingId} {
      // Allow create if auth is present and device_id is a string
      allow create: if request.auth != null
                    && request.resource.data.device_id is string;
      
      // Allow update for feedback only
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback']);
                    
      allow read: if false;
      allow delete: if false;
    }
  }
}
